APP_NAME=Yuejiao Education Service Admin
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true
API_V1_PREFIX=/api/v1

# 数据库连接 (MySQL 8.0)
DATABASE_URL=mysql+asyncmy://root:123456@127.0.0.1:3306/yuejiao_service?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=yuejiao_service
DB_CHARSET=utf8mb4

JWT_SECRET=change-me-in-local-env
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173

# 客服 Agent Dify 配置 (本地 Docker 8080 端口，版本 1.17.0)
DIFY_API_BASE_URL=http://127.0.0.1:8080/v1
DIFY_API_KEY=

# 企业智能助手 Dify 配置
DIFY_BASE_URL=http://localhost/v1
DIFY_ENTERPRISE_API_KEY=
DIFY_TOOL_TOKEN=

# 智能报告 Workflow 配置
DIFY_COMPLAINT_WEEKLY_API_KEY=
DIFY_DAILY_SUMMARY_API_KEY=
DIFY_PSYCH_WEEKLY_API_KEY=
DIFY_CUSTOMER_OPS_API_KEY=
DIFY_TIMEOUT_SECONDS=90
