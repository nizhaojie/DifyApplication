APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# 先建库再跑 公用/表/db_init.sql，库名自定，和这里保持一致
DATABASE_URL=mysql+asyncmy://root:你的密码@127.0.0.1:3306/yuejiao?charset=utf8mb4

JWT_SECRET=change-me-in-local-env
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# 本机 Dify 1.17 默认走 80 端口；密钥只放本机 .env，不要提交
# 访问点：工作室 → 粤教-企业智能助手 → 访问点 → API 密钥（app- 开头）
DIFY_BASE_URL=http://localhost/v1
DIFY_ENTERPRISE_API_KEY=
# Dify HTTP 节点调后端时带的头。开发态 DEBUG=true 且此项为空时不校验
DIFY_TOOL_TOKEN=

# 智能报告 Workflow（test 分支）。不配 MYSQL_* 时从 DATABASE_URL 解析同一库
# DIFY_API_BASE 不配时沿用上面的 DIFY_BASE_URL
DIFY_COMPLAINT_WEEKLY_API_KEY=
DIFY_DAILY_SUMMARY_API_KEY=
DIFY_PSYCH_WEEKLY_API_KEY=
DIFY_CUSTOMER_OPS_API_KEY=
DIFY_TIMEOUT_SECONDS=90
