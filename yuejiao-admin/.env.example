APP_NAME=Yuejiao Education Service Admin
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002
SERVER_HOST=0.0.0.0
SERVER_PORT=8002
DEBUG=true
API_V1_PREFIX=/api/v1

# 数据库连接 (MySQL 8.0)
DATABASE_URL=mysql+asyncmy://root:123456@127.0.0.1:3306/yuejiao_db?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=yuejiao_db
DB_CHARSET=utf8mb4

JWT_SECRET=change-me-in-local-env
JWT_EXPIRE_MINUTES=720

CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Dify YML 统一目录（留空则使用仓库根 dify/ 目录，设置时用绝对路径）
DIFY_YML_DIR=

# 客服 Agent Dify 配置 (本地 Docker 8080 端口，版本 1.17.0)
DIFY_API_BASE_URL=http://127.0.0.1:8080/v1
DIFY_API_KEY=

# 企业智能助手 Dify 配置
DIFY_BASE_URL=http://localhost/v1
DIFY_ENTERPRISE_API_KEY=
DIFY_TOOL_TOKEN=

# Student Assistant Dify applications
DIFY_STUDENT_PSYCH_BASE_URL=
DIFY_STUDENT_PSYCH_API_KEY=
DIFY_STUDENT_LIFE_BASE_URL=
DIFY_STUDENT_LIFE_API_KEY=
DIFY_STUDENT_PROGRAM_BASE_URL=
DIFY_STUDENT_PROGRAM_API_KEY=

# 智能报告 Workflow 配置
DIFY_COMPLAINT_WEEKLY_API_KEY=
DIFY_DAILY_SUMMARY_API_KEY=
DIFY_PSYCH_WEEKLY_API_KEY=
DIFY_CUSTOMER_OPS_API_KEY=
DIFY_TIMEOUT_SECONDS=90

# 粤小蜜悬浮球直连 Dify：App Key 配在 yuejiao-web/前端代码/.env 的 DIFY_APP_API_KEY
# （Vite 代理注入，不要写成 VITE_ 前缀）。本文件的 DIFY_API_KEY 给 FastAPI /api/v1/cs 用，球不走这条链。
